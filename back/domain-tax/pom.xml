<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-030 (doc/architecture/20-backlog-modules-maven-patchs.md) : domaine Fiscalité
        (calculateur, entrée/paramètres, projection TaxProjection, modèles fiscaux, ports Reader/Writer).

        Dépendance autorisée : domain-retirement, uniquement pour le contrat de projection
        AnnualTaxableRetirementIncome (jamais l'implémentation RetirementCalculationService).
        Aucune dépendance vers Spring, JPA, OpenAPI, PersistenceManager ou BudgetDataModel.
        Dépendances de test uniquement : JUnit 5 et AssertJ (versions gérées par le BOM du parent).
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>domain-tax</artifactId>
    <packaging>jar</packaging>
    <name>domain-tax</name>
    <description>Domaine Fiscalité MyFamilyBudget (calculateur pur, sans Spring ni JPA)</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>domain-retirement</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
