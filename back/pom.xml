                <version>${tax.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>tax-core</artifactId>
                <version>${tax.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>wealth-api</artifactId>
                <version>${wealth.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
