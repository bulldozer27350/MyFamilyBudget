        <repository>
            <id>domain-treasury-packages</id>
            <name>GitHub Packages myfamilybudget-domain-treasury</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-treasury</url>
        </repository>
        <repository>
            <id>domain-analysis-packages</id>
            <name>GitHub Packages myfamilybudget-domain-analysis</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-analysis</url>
        </repository>
        <repository>
            <id>domain-goals-packages</id>
            <name>GitHub Packages myfamilybudget-domain-goals</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-goals</url>
        </repository>
        <repository>
            <id>domain-settings-packages</id>
            <name>GitHub Packages myfamilybudget-domain-settings</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-settings</url>
        </repository>
        <repository>
            <id>domain-notifications-packages</id>
            <name>GitHub Packages myfamilybudget-domain-notifications</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-notifications</url>
        </repository>
        <repository>
            <id>domain-market-packages</id>
            <name>GitHub Packages myfamilybudget-domain-market</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-market</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Modules internes du reactor (versions alignées sur celle du parent) -->
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>retirement-api</artifactId>
                <version>${retirement.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>retirement-core</artifactId>
                <version>${retirement.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
