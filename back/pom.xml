<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-000 (doc/architecture/20-backlog-modules-maven-patchs.md) : parent Maven (packaging pom)
        du reactor multi-module du backend.

        Décisions :
        - le parent est un pom racine dédié (back/pom.xml), distinct de back/server/pom.xml ;
        - le module `server` (back/server) reste, pour l'instant, le seul module qui porte du code
          et l'exécutable final (target/server-1.0.0-SNAPSHOT.jar) : Dockerfile, CI, lanceurs
          .bat/.sh et gate VT-600 continuent donc de pointer sur back/server ; il deviendra le
          composition root `server-app` à MAVEN-130 ;
        - `mvn -f back/server/pom.xml ...` reste possible (le parent est résolu via relativePath) ;
          `mvn -f back/pom.xml ...` construit le reactor complet.

        Ce parent ne porte que des versions (properties, dependencyManagement, pluginManagement) :
        aucune dépendance ni aucun plugin n'est activé ici, pour ne rien imposer aux futurs modules.
        Les nouveaux modules sont ajoutés à la section <modules> au fil des items MAVEN-010 à MAVEN-130
        (MAVEN-010 : domain-budget ; MAVEN-020 : domain-retirement ; MAVEN-030 : domain-tax ; MAVEN-040 : domain-wealth ; MAVEN-060 : domain-bank-pointage ; MAVEN-050 : domain-treasury).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>com.moe.myfamilybudget</groupId>
    <artifactId>myfamilybudget-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>myfamilybudget-parent</name>
    <description>Parent Maven (reactor) du backend MyFamilyBudget</description>

    <modules>
        <module>domain-budget</module>
        <module>domain-retirement</module>
        <module>domain-tax</module>
        <module>domain-wealth</module>
        <module>domain-bank-pointage</module>
        <module>domain-treasury</module>
        <module>server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        
        <!--
            `spring-boot:run` lancé depuis le reactor (mvn -f back/pom.xml -pl server -am ...) s'exécute
            sur chaque module sélectionné (parent pom inclus) : il est ignoré par défaut et réactivé
            uniquement dans `server` (seul module avec une classe main).
        -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
        
        <!-- Versions des plugins -->
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-assembly-plugin.version>3.6.0</maven-assembly-plugin.version>
        <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
        <openapi-generator.version>7.10.0</openapi-generator.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <node.version>v20.18.1</node.version>

        <!-- Versions des dépendances non gérées par le BOM Spring Boot -->
        <jackson-nullable.version>0.2.6</jackson-nullable.version>
        <swagger-annotations.version>2.2.28</swagger-annotations.version>
        <archunit.version>1.3.0</archunit.version>
        <poi.version>5.2.5</poi.version>
        <web-push.version>5.1.1</web-push.version>
        <bouncycastle.version>1.78</bouncycastle.version>
        <httpclient4.version>4.5.14</httpclient4.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Modules internes du reactor (versions alignées sur celle du parent) -->
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>domain-budget</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>domain-retirement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>domain-tax</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>domain-wealth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>domain-bank-pointage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>domain-treasury</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.openapitools</groupId>
                <artifactId>jackson-databind-nullable</artifactId>
                <version>${jackson-nullable.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>nl.martijndwars</groupId>
                <artifactId>web-push</artifactId>
                <version>${web-push.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient4.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${frontend-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
