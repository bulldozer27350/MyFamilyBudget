<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-000 (doc/architecture/20-backlog-modules-maven-patchs.md) : parent Maven (packaging pom)
        du reactor multi-module du backend.

        Décisions :
        - le parent est un pom racine dédié (back/pom.xml), distinct des pom.xml de chaque module ;
        - R-91 (SILO-330) : le composition root exécutable (démarrage, câblage des implémentations,
          DesktopLauncher) a été extrait de `server` vers un nouveau module `bootstrap`
          (target/bootstrap-1.0.0-SNAPSHOT.jar). `server` ne porte plus de code de production ; il
          reste le support des tests d'intégration et des garde-fous d'architecture (ArchUnit) du
          reactor, en dépendance de test sur `bootstrap` et sur les autres modules. Écart signalé par
          R-91 : Dockerfile, CI, lanceurs .bat/.sh et gate VT-600 pointaient sur back/server et n'ont
          pas été repris par ce patch (hors périmètre de sa cartographie) — à faire suivre par un
          patch dédié avant toute bascule de build/déploiement réel ;
        - `mvn -f back/bootstrap/pom.xml ...` reste possible (le parent est résolu via relativePath) ;
          `mvn -f back/pom.xml ...` construit le reactor complet.

        Ce parent ne porte que des versions (properties, dependencyManagement, pluginManagement) :
        aucune dépendance ni aucun plugin n'est activé ici, pour ne rien imposer aux futurs modules.
        Les nouveaux modules sont ajoutés à la section <modules> au fil des items MAVEN-010 à MAVEN-130
        (MAVEN-010 : domain-budget ; MAVEN-020 : domain-retirement, devenu retirement-api et retirement-core à SILO-150 ; MAVEN-030 : domain-tax, devenu tax-api et tax-core à SILO-151 ; MAVEN-040 : domain-wealth, devenu wealth-api et wealth-core à SILO-152 ; MAVEN-060 : domain-bank-pointage, devenu bank-pointage-api et bank-pointage-core à SILO-154 ; MAVEN-050 : domain-treasury, devenu treasury-api et treasury-core à SILO-153 ; MAVEN-070 : domain-analysis, devenu analysis-api et analysis-core à SILO-155 ; MAVEN-080 : domain-credit, devenu credit-api et credit-core à SILO-156, domain-goals, devenu goals-api à SILO-157, puis goals-core à SILO-212 ; MAVEN-090 : domain-notifications, devenu notifications-api et notifications-core à SILO-158 ; silo Marché : market-api et market-core à SILO-159 ; MAVEN-100 : transition-snapshot, application ; MAVEN-110 : api ; MAVEN-120 : persistence ; SILO-200 : infra-jpa ; SILO-300 : application-api).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>com.moe.myfamilybudget</groupId>
    <artifactId>myfamilybudget-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>myfamilybudget-parent</name>
    <description>Parent Maven (reactor) du backend MyFamilyBudget</description>

    <modules>
        <module>myfamilybudget-bom</module>
        <module>api</module>
        <module>infra-jpa</module>
        <module>application-api</module>
        <module>application</module>
        <module>web</module>
        <module>bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        
        <!--
            `spring-boot:run` lancé depuis le reactor (mvn -f back/pom.xml -pl bootstrap -am ...)
            s'exécute sur chaque module sélectionné (parent pom inclus) : il est ignoré par défaut et
            réactivé uniquement dans `bootstrap` (seul module avec une classe main, depuis R-91).
        -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
        
        <!-- Versions des plugins -->
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-assembly-plugin.version>3.6.0</maven-assembly-plugin.version>
        <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
        <openapi-generator.version>7.10.0</openapi-generator.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <node.version>v22.23.3</node.version>
        <moditect-maven-plugin.version>1.0.0.Final</moditect-maven-plugin.version>
        <japicmp-maven-plugin.version>0.23.1</japicmp-maven-plugin.version>

        <!-- Versions des dépendances non gérées par le BOM Spring Boot -->
        <jackson-nullable.version>0.2.6</jackson-nullable.version>
        <swagger-annotations.version>2.2.28</swagger-annotations.version>
        <archunit.version>1.3.0</archunit.version>
        <poi.version>5.2.5</poi.version>
        <web-push.version>5.1.1</web-push.version>
        <bouncycastle.version>1.78</bouncycastle.version>
        <httpclient4.version>4.5.14</httpclient4.version>

        <!-- Silos autonomes externalisés -->
        <credit.version>0.0.1-SNAPSHOT</credit.version>
        <retirement.version>0.0.1-SNAPSHOT</retirement.version>
        <tax.version>0.0.1-SNAPSHOT</tax.version>
        <wealth.version>0.0.1-SNAPSHOT</wealth.version>
        <bank-pointage.version>0.0.1-SNAPSHOT</bank-pointage.version>
        <treasury.version>0.0.1-SNAPSHOT</treasury.version>
        <analysis.version>0.0.1-SNAPSHOT</analysis.version>
        <goals.version>0.0.1-SNAPSHOT</goals.version>
        <settings.version>0.0.1-SNAPSHOT</settings.version>
        <notifications.version>0.0.1-SNAPSHOT</notifications.version>
        <market.version>0.0.1-SNAPSHOT</market.version>
    </properties>

    <repositories>
        <repository>
            <id>domain-credit-packages</id>
            <name>GitHub Packages myfamilybudget-domain-credit</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-credit</url>
        </repository>
        <repository>
            <id>domain-retirement-packages</id>
            <name>GitHub Packages myfamilybudget-domain-retirement</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-retirement</url>
        </repository>
        <repository>
            <id>domain-tax-packages</id>
            <name>GitHub Packages myfamilybudget-domain-tax</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-tax</url>
        </repository>
        <repository>
            <id>domain-wealth-packages</id>
            <name>GitHub Packages myfamilybudget-domain-wealth</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-wealth</url>
        </repository>
        <repository>
