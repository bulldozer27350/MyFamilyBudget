<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SILO-156 (doc/architecture/21-plan-silotage.md) : cœur du silo Crédit (moteur de calcul
        `DefaultLoanAdviceCalculationService`, implémentation de l'interface de `credit-api`).

        SILO-214 : il porte aussi la persistance JPA autonome du silo (package `domain.credit.core.persistence` :
        entités `credit_loan` et `loan_advice_settings`, repositories Spring Data et mapper des prêts), découverte
        par le scan par défaut de Spring Boot (racine `com.moe.myfamilybudget`). Le moteur reste sans Spring ni JPA.

        Règle : ce module ne dépend que de `credit-api` et de `infra-jpa` (configuration JPA commune, qui apporte
        Spring Data JPA et Hibernate). Pas de `module-info` (décision D3) : visibilité tenue par le graphe Maven
        (règle C de `MavenModuleGraphTest`) et ArchUnit. Seul le composition root (server) le référence ;
        `application` ne dépend que de `credit-api`. Le moteur n'est pas un @Component : son bean est déclaré par
        `DomainEngineConfig`.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>credit-core</artifactId>
    <packaging>jar</packaging>
    <name>credit-core</name>
    <description>Cœur du silo Crédit MyFamilyBudget (moteur de conseil sur les prêts pur, et persistance JPA des prêts et des hypothèses de l'analyse)</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>credit-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>infra-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
