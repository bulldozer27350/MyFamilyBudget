<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-050 (doc/architecture/20-backlog-modules-maven-patchs.md) : domaine Trésorerie
        (moteur de projection, contrats d'entrée/sortie, modèles de résultat, ports Writer et
        énumérations de champs).

        SILO-140 : domain-budget est dissous, ses modèles (revenus, charges, ponctuels, virements, revenus
        variables, résultats de flux) rejoignent le package treasury.model. SILO-132 : aucune dépendance
        vers un autre module du reactor ; Trésorerie définit ses propres entrées (TreasuryPensionProjection, TreasuryTaxProjection,
        TreasuryPlacementCashflow) et l'application traduit.
        Aucune dépendance vers Spring, JPA, OpenAPI, PersistenceManager, BudgetDataModel,
        internal.impl ni internal.factory. Dépendances de test uniquement : JUnit 5 et AssertJ.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>domain-treasury</artifactId>
    <packaging>jar</packaging>
    <name>domain-treasury</name>
    <description>Domaine Trésorerie MyFamilyBudget (moteur pur, sans Spring ni JPA)</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
