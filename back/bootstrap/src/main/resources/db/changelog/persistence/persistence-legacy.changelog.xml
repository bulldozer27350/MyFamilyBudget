<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Tables encore legacy (R-01, 24-backlog-reste-a-faire.md) : hub budget_data (R-61), settings
        (R-51/R-52), placement/placement_history_entry (R-30, pas encore bascules vers wealth-core).
        Changelog du module persistence : tables actuelles : budget_data, settings, placement,
        placement_history_entry.

        real_estate et asset_category, encore citees dans une version precedente de ce commentaire,
        n'ont plus d'entite JPA dans le code actuel (migration deja faite vers wealth_real_estate et
        wealth_category) : ce ne sont que des tables orphelines, exclues de la baseline ci-dessous au
        meme titre que les autres noms legacy nettoyes par LegacySchemaCleanup (ex. tax_bracket,
        income, objectif : voir 23-registre-decisions-actives.md, DA-16).

        Lot B (R-01) : changeSet de baseline ci-dessous, genere via `mvn liquibase:generateChangeLog`
        (cf. db/changelog/README.md, module bootstrap) sur une base neuve (reset propre). Les tables qui
        migrent vers un silo (ex. future suite de R-30 vers wealth-core) quittent ce fichier pour
        celui du silo au patch qui les bascule, par un changeSet de renommage/deplacement, pas par
        copier-coller.
    -->

    <changeSet author="R-01-lot-b" id="r01-persistence-1">
        <createTable tableName="budget_data">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="budget_data_pkey"/>
            </column>
            <column name="settings_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet author="R-01-lot-b" id="r01-persistence-2">
        <addUniqueConstraint columnNames="settings_id" constraintName="uk2fmct21wgsqqlg74i0e1dcd7n" tableName="budget_data"/>
    </changeSet>
    <changeSet author="R-01-lot-b" id="r01-persistence-3">
        <createTable tableName="placement">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="placement_pkey"/>
            </column>
            <column name="balance" type="numeric(38, 2)"/>
            <column name="balance_date" type="VARCHAR(255)"/>
            <column name="category" type="VARCHAR(255)"/>
            <column name="category_id" type="VARCHAR(255)"/>
            <column name="excluded_from_retirement" type="BOOLEAN"/>
            <column name="label" type="VARCHAR(255)"/>
            <column name="monthly" type="numeric(38, 2)"/>
            <column name="monthly_from" type="VARCHAR(255)"/>
            <column name="monthly_until" type="VARCHAR(255)"/>
            <column name="notes" type="VARCHAR(255)"/>
            <column name="pause_priority" type="INTEGER"/>
            <column name="pause_trigger_balance" type="numeric(38, 2)"/>
            <column name="rate_corr" type="numeric(19, 8)"/>
            <column name="rate_opti" type="numeric(19, 8)"/>
            <column name="rate_pess" type="numeric(19, 8)"/>
            <column name="sweep_cap" type="numeric(38, 2)"/>
            <column name="sweep_priority" type="INTEGER"/>
            <column name="uid" type="VARCHAR(255)"/>
            <column name="budget_data_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet author="R-01-lot-b" id="r01-persistence-4">
        <createTable tableName="placement_history_entry">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="placement_history_entry_pkey"/>
            </column>
            <column name="date" type="VARCHAR(255)"/>
            <column name="notes" type="VARCHAR(255)"/>
            <column name="uid" type="VARCHAR(255)"/>
            <column name="value_amount" type="numeric(38, 2)"/>
            <column name="placement_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet author="R-01-lot-b" id="r01-persistence-5">
        <createTable tableName="settings">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="settings_pkey"/>
            </column>
            <column name="birth_year" type="INTEGER"/>
            <column name="cash_alert_threshold" type="numeric(38, 2)"/>
            <column name="cash_ceiling" type="numeric(38, 2)"/>
            <column name="cash_floor" type="numeric(38, 2)"/>
            <column name="child_exit_age" type="INTEGER"/>
            <column name="inflation_rate" type="numeric(19, 8)"/>
            <column name="pass2026" type="numeric(38, 2)"/>
            <column name="pass_growth_rate" type="numeric(19, 8)"/>
            <column name="pivot_date" type="VARCHAR(255)"/>
            <column name="pivot_mode" type="VARCHAR(255)"/>
            <column name="retire_age" type="INTEGER"/>
            <column name="simulate_until_age" type="INTEGER"/>
            <column name="start_balance" type="numeric(38, 2)"/>
            <column name="sweep_enabled" type="BOOLEAN"/>
            <column name="tax_abattement" type="numeric(19, 8)"/>
        </createTable>
    </changeSet>
    <changeSet author="R-01-lot-b" id="r01-persistence-6">
        <addForeignKeyConstraint baseColumnNames="settings_id" baseTableName="budget_data" constraintName="fkf6p9o787fy5j771te2tb8kut2" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="settings" validate="true"/>
    </changeSet>
    <changeSet author="R-01-lot-b" id="r01-persistence-7">
        <addForeignKeyConstraint baseColumnNames="placement_id" baseTableName="placement_history_entry" constraintName="fkfyopbe4abtcsnb7myq9bhai7l" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="placement" validate="true"/>
    </changeSet>
    <changeSet author="R-01-lot-b" id="r01-persistence-8">
        <addForeignKeyConstraint baseColumnNames="budget_data_id" baseTableName="placement" constraintName="fkp8q5hxfw0wdx45hp6hq96rdcw" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="budget_data" validate="true"/>
    </changeSet>

    <!--
        R-51 (24-backlog-reste-a-faire.md, DA-15 de 23-registre-decisions-actives.md) : SettingsEntity est
        retiree (avec SettingsPersistenceAdapter et SettingsRepository, deja retires cote Java ; syncSettings
        etait deja retire par R-20/R-40/R-42). Le PASS (pass2026/passGrowthRate) appartient au domaine
        Retraite (pension_plan.pass_2026/pass_growth_rate, silo retirement-core, voir
        retirement-core.changelog.xml) : avant de supprimer les colonnes de settings, on copie une derniere
        fois sa valeur vers pension_plan, uniquement la ou celle-ci est encore vide (on ne doit jamais ecraser
        une valeur deja saisie cote Retraite). Les 13 autres colonnes de settings sont mortes depuis SET-040
        (plus aucune donnee a y preserver) : simple suppression. `settings` et `pension_plan` sont toutes deux
        des tables singleton (au plus une ligne, voir findFirstByOrderByIdAsc cote JPA) ; le ORDER BY id ASC
        LIMIT 1 des sous-requetes est une precaution si cette hypothese etait un jour violee.
    -->
    <changeSet author="R-51" id="r51-persistence-1">
        <sql>
            UPDATE pension_plan
            SET pass_2026 = (SELECT s.pass2026 FROM settings s ORDER BY s.id ASC LIMIT 1)
            WHERE pass_2026 IS NULL
              AND (SELECT s.pass2026 FROM settings s ORDER BY s.id ASC LIMIT 1) IS NOT NULL;
        </sql>
    </changeSet>
    <changeSet author="R-51" id="r51-persistence-2">
        <sql>
            UPDATE pension_plan
            SET pass_growth_rate = (SELECT s.pass_growth_rate FROM settings s ORDER BY s.id ASC LIMIT 1)
            WHERE pass_growth_rate IS NULL
              AND (SELECT s.pass_growth_rate FROM settings s ORDER BY s.id ASC LIMIT 1) IS NOT NULL;
        </sql>
    </changeSet>
    <changeSet author="R-51" id="r51-persistence-3">
        <dropColumn tableName="settings">
            <column name="birth_year"/>
            <column name="cash_alert_threshold"/>
            <column name="cash_ceiling"/>
            <column name="cash_floor"/>
            <column name="child_exit_age"/>
            <column name="inflation_rate"/>
            <column name="pass2026"/>
            <column name="pass_growth_rate"/>
            <column name="pivot_date"/>
            <column name="pivot_mode"/>
            <column name="retire_age"/>
            <column name="simulate_until_age"/>
            <column name="start_balance"/>
            <column name="sweep_enabled"/>
            <column name="tax_abattement"/>
        </dropColumn>
    </changeSet>

    <!--
        R-61 (24-backlog-reste-a-faire.md, 26-sequencage-r61-suppression-hub.md) : suppression du hub
        et du modele global (BudgetDataEntity, PlacementEntity, PlacementHistoryEntryEntity, et ce qui
        reste de SettingsEntity apres R-51) ; plus aucun code Java du module persistence (supprime en
        bloc en R-61-24) n'ecrit ni ne lit ces 4 tables. DA-02 : aucune cle etrangere inter-silo a
        preserver ici, ces FK ne relient que des tables legacy entre elles (budget_data -> settings,
        placement -> budget_data, placement_history_entry -> placement) ; cascadeConstraints="true"
        supprime ces FK avec leur table sans sequence manuelle supplementaire. Ordre : les tables
        enfants (au sens FK) d'abord, settings en dernier (n'est plus reference par aucune FK depuis la
        suppression de settings_id -> aucune contrainte sur budget_data a ce stade, mais l'ordre suit
        quand meme child -> parent par coherence avec le schema d'origine).
    -->
    <changeSet author="R-61" id="r61-persistence-1">
        <dropTable cascadeConstraints="true" tableName="placement_history_entry"/>
    </changeSet>
    <changeSet author="R-61" id="r61-persistence-2">
        <dropTable cascadeConstraints="true" tableName="placement"/>
    </changeSet>
    <changeSet author="R-61" id="r61-persistence-3">
        <dropTable cascadeConstraints="true" tableName="budget_data"/>
    </changeSet>
    <changeSet author="R-61" id="r61-persistence-4">
        <dropTable cascadeConstraints="true" tableName="settings"/>
    </changeSet>

</databaseChangeLog>
