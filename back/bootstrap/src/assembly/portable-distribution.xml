<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>portable-distribution</id>
    <formats>
        <format>zip</format>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>MyFamilyBudget</baseDirectory>

    <files>
        <!-- JAR exécutable Spring Boot avec Frontend embarqué -->
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>/</outputDirectory>
            <destName>MyFamilyBudget.jar</destName>
        </file>
        <!-- Page SplashScreen autonome immédiate -->
        <file>
            <source>${project.basedir}/../../splashscreen.html</source>
            <outputDirectory>/</outputDirectory>
            <destName>splashscreen.html</destName>
            <filtered>false</filtered>
        </file>
        <!-- Scripts de lancement racine -->
        <file>
            <source>${project.basedir}/../../MyFamilyBudget.bat</source>
            <outputDirectory>/</outputDirectory>
            <destName>MyFamilyBudget.bat</destName>
            <filtered>false</filtered>
        </file>
        <file>
            <source>${project.basedir}/../../MyFamilyBudget.sh</source>
            <outputDirectory>/</outputDirectory>
            <destName>MyFamilyBudget.sh</destName>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
            <filtered>false</filtered>
        </file>
    </files>

    <fileSets>
        <!-- Documentation / Manuel -->
        <fileSet>
            <directory>${project.basedir}/../../view</directory>
            <outputDirectory>/docs</outputDirectory>
            <includes>
                <include>Manuel utilisateur.md</include>
            </includes>
        </fileSet>
        <!-- Dossier de données vierge -->
        <fileSet>
            <directory>${project.basedir}/src/main/resources</directory>
            <outputDirectory>/data</outputDirectory>
            <excludes>
                <exclude>**/*</exclude>
            </excludes>
        </fileSet>
    </fileSets>
</assembly>
