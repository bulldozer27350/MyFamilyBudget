<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SILO-200 (doc/architecture/21-plan-silotage.md) : module d'infrastructure JPA commun aux silos.

        Il ne porte que la configuration technique d'Hibernate (stratégie de nommage physique) : aucun type
        métier, aucune entité, aucun repository, aucune dépendance vers un autre module du reactor. Les silos
        (`*-core`) pourront en dépendre à partir de SILO-210 ; `application*` et `web` ne le voient jamais
        (règle C de `MavenModuleGraphTest`). Pas de `module-info` (décision D3 : module Spring/JPA).

        La source de données (URL, pilote, identifiants) reste dans les `application*.yml` du composition root :
        c'est de la configuration d'exécution, pas du code.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>com.moe.myfamilybudget</groupId>
    <artifactId>infra-jpa</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>
    <name>infra-jpa</name>
    <description>Configuration JPA/Hibernate commune aux silos MyFamilyBudget (aucun type métier)</description>

    <properties>
        <!--
            REL-010 : ce module n'hérite pas de myfamilybudget-parent (cf. commentaire ci-dessus), donc sa
            propriété `revision` est déclarée ici en miroir de celle du pom racine (back/pom.xml), et non
            héritée. À garder synchronisée à chaque changement de version du reactor, ou à piloter
            uniformément avec `-Drevision=X.Y.Z` sur la ligne de commande (fait par l'orchestrateur de
            release, REL-070), qui prévaut sur la valeur locale ci-dessous.
        -->
        <revision>0.2.0-SNAPSHOT</revision>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>

        <java.version>21</java.version>

        <!--
            spring-boot.run.skip : herite auparavant de myfamilybudget-parent (true par defaut pour
            tous les modules sauf bootstrap). infra-jpa n'ayant plus ce parent (cf. patch precedent,
            module autonome sur spring-boot-starter-parent), la propriete doit etre redeclaree ici :
            sans elle, `mvn -pl bootstrap -am ... spring-boot-maven-plugin:run` (tests/e2e/setup.js)
            tente de lancer infra-jpa comme une application (pas de mainClass -> echec).
        -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencies>
        <!-- JPA/Hibernate, Spring Data JPA, auto-configuration Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- REL-010 : résout `${revision}` dans le pom publié, sans toucher au pom.xml source
         (updatePomFile=false). Déclaré localement (pas hérité de spring-boot-starter-parent). -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>false</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/bulldozer27350/MyFamilyBudget</url>
        </repository>
    </distributionManagement>
</project>
