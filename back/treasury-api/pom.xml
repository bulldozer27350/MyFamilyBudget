<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-050 puis SILO-153 (doc/architecture/21-plan-silotage.md) : API du silo Trésorerie
        (interface de service TresorerieCalculationService, contrats d'entrée/sortie, modèles, ports
        Reader/Writer et énumérations de champs). Le moteur `DefaultTresorerieCalculationService` vit dans
        `treasury-core`. Nom de module Java inchangé (`com.moe.myfamilybudget.domain.treasury`).

        SILO-140 : domain-budget est dissous, ses modèles (revenus, charges, ponctuels, virements, revenus
        variables, résultats de flux) rejoignent le package treasury.model. SILO-132 : aucune dépendance
        vers un autre module du reactor ; Trésorerie définit ses propres entrées (TreasuryPensionProjection, TreasuryTaxProjection,
        TreasuryPlacementCashflow) et l'application traduit.
        Aucune dépendance vers Spring, JPA, OpenAPI, PersistenceManager, BudgetDataModel,
        internal.impl ni internal.factory. Aucune dépendance de test : le module ne contient que des
        contrats, testés par `treasury-core`.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>treasury-api</artifactId>
    <packaging>jar</packaging>
    <name>treasury-api</name>
    <description>API du silo Trésorerie MyFamilyBudget (contrats, ports, interfaces de service ; sans Spring ni JPA)</description>

</project>
