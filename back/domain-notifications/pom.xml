<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-090 (doc/architecture/20-backlog-modules-maven-patchs.md) : domaine Notifications
        (contrat NotificationRule/NotificationMessage, paramètres métier de notification, règles
        pures DebitThresholdRule / BalanceFloorRule / ObjectifReachableRule et leurs entrées).

        Notifications est un consommateur final de contrats : seule dépendance de production,
        domain-goals (ObjectifReachableInput, PlacementBalanceSnapshot). Aucune dépendance vers
        Spring, JPA, Web Push, OpenAPI, PersistenceManager ou BudgetDataModel ; la dédup, le
        dispatch, les canaux et la persistance des paramètres restent hors du module.
        Dépendances de test uniquement : JUnit 5 et AssertJ.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>domain-notifications</artifactId>
    <packaging>jar</packaging>
    <name>domain-notifications</name>
    <description>Domaine Notifications MyFamilyBudget (règles pures, sans Spring ni JPA)</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>domain-goals</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
