<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        R-90 / SILO-320 (doc/architecture/24-backlog-reste-a-faire.md, doc/architecture/21-plan-silotage.md) :
        module web (contrôleurs REST implémentant les interfaces *Api générées par OpenAPI, mappers DTO,
        GlobalExceptionHandler, CORS, HeartbeatController).

        Dépendances de production :
          - application-api (interfaces des cas d'usage)
          - application (implémentation et mappers internes nécessaires)
          - api (contrats REST OpenAPI générés : DTO et interfaces *Api)
          - market-api (MarketDataService pour TauxMarcheServiceImpl)
          - bank-pointage-api (EnableBankingSyncService pour EnableBankingApiServiceImpl)
          - spring-boot-starter-web (ou spring-web / spring-webmvc pour @RestController, ResponseEntity)
          - spring-boot-starter-validation (Bean Validation pour @Valid)
          - poi-ooxml (lecture fichiers Excel pour ExcelToCsvService)
          - slf4j-api
          - goals-api, settings-api, tax-api (lus directement par OverviewServiceImpl, ParametersServiceImpl,
            AnalyseServiceImpl ; déclarés ici en R-92 pour correspondre à l'usage réel, auparavant résolus
            uniquement par transitivité via `application`)

        R-92 (DA-01) : `module-info` présent (module `com.moe.myfamilybudget.web`).
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>web</artifactId>
    <packaging>jar</packaging>
    <name>web</name>
    <description>Couche Web MyFamilyBudget (contrôleurs REST, mappers DTO, gestion des erreurs, CORS)</description>

    <dependencies>
        <!-- Cas d'usage applicatifs (SILO-300 à SILO-319) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>application-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>application</artifactId>
        </dependency>

        <!-- Silos dont les contrôleurs consomment directement un service d'API -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>market-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>bank-pointage-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>retirement-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>credit-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>notifications-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>treasury-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>wealth-api</artifactId>
        </dependency>
        <!-- R-92 : déclarées explicitement, utilisées directement par OverviewServiceImpl, ParametersServiceImpl
             et AnalyseServiceImpl (auparavant transitives via `application`) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>goals-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>settings-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>tax-api</artifactId>
        </dependency>

        <!-- Contrat REST généré : DTO et interfaces *Api (MAVEN-110) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Apache POI — Lecture fichiers Excel (.xls et .xlsx) (ExcelToCsvService) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
