<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SILO-151 (doc/architecture/21-plan-silotage.md) : cœur du silo Fiscalité (moteur de calcul
        `DefaultTaxCalculationService`, implémentation de l'interface de `tax-api`).

        SILO-211 : il porte aussi la persistance JPA autonome du silo (package `domain.tax.core.persistence` :
        entités `fiscal_*`, repositories Spring Data et mapper entité/modèle), découverte par le scan par défaut
        de Spring Boot (racine `com.moe.myfamilybudget`).

        Règle : ce module ne dépend que de `tax-api` et de `infra-jpa` (configuration JPA commune, qui apporte
        Spring Data JPA et Hibernate). Pas de `module-info` (décision D3) : visibilité tenue par le graphe Maven
        (règle C de `MavenModuleGraphTest`) et ArchUnit. Seul le composition root (server) le référence ; `application` ne dépend que de `tax-api`.
        Le moteur n'est pas un @Component : son bean est déclaré par `DomainEngineConfig`.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tax-core</artifactId>
    <packaging>jar</packaging>
    <name>tax-core</name>
    <description>Cœur du silo Fiscalité MyFamilyBudget (moteur de calcul et persistance JPA des tables fiscal_*)</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>tax-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>infra-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
