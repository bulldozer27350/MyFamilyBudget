<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-100 / MAVEN-102 (doc/architecture/20-backlog-modules-maven-patchs.md) : module d'orchestration
        applicative (`application.command`, `application.factory`, `application.settings` ; MAVEN-102 :
        `application.service` (implémentations des interfaces REST générées), `application.mapper`,
        `application.model` (modèles de résultat) et `application.error`).

        Dépendances de production : les modules `*-api` des silos (jamais un `*-core` : règle C de
        MavenModuleGraphRules et ApplicationWithoutSiloCoreArchTest, SILO-160 ; les moteurs sont fournis par
        injection depuis `server`), `transition-snapshot` (BudgetDataModel, SettingsModel
        et ports transverses), `api` (contrat REST généré, MAVEN-110 : DTO et interfaces `*Api` implémentées par
        les services ; apporte spring-web et Jakarta Validation), `spring-context`
        (stéréotypes ; plus de `spring-tx` depuis SILO-205 : la transaction passe par le port `TransactionRunner`), `poi-ooxml` (lecture Excel de l'import bancaire) et `slf4j-api`.
        Aucune dépendance vers JPA, PersistenceManager, `persistence` ni vers le module `server`.
        Aucun domaine pur ne dépend de ce module.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>application</artifactId>
    <packaging>jar</packaging>
    <name>application</name>
    <description>Couche applicative MyFamilyBudget (commands, factories d'Input, assemblers), sans JPA ni OpenAPI</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>transition-snapshot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>retirement-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>tax-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>wealth-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>bank-pointage-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>treasury-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>analysis-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>credit-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>goals-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>notifications-api</artifactId>
        </dependency>

        <!-- Contrat REST généré : DTO et interfaces *Api implémentées par application.service (MAVEN-102) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Apache POI — Lecture fichiers Excel (.xls et .xlsx) (ExcelToCsvService) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
