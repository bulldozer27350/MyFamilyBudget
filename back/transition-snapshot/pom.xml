<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-100 (doc/architecture/20-backlog-modules-maven-patchs.md), option B : module de transition qui porte
        le snapshot global `BudgetDataModel`, `SettingsModel` et les ports transverses de lecture/écriture
        (`BudgetReader`, `SettingsReader`, `EconomicAssumptionsWriter`,
        `SimulationSettingsWriter`).

        Il dépend uniquement des modules de domaine dont il agrège les modèles ; aucun module de domaine ne dépend
        de lui (sens unique : application et persistence -> transition-snapshot -> domaines).
        Aucune dépendance vers Spring, JPA, OpenAPI ou PersistenceManager : seul le JDK est utilisé en production.
        Ce module disparaît (ou se réduit) avec DB-1180, quand BudgetDataModel sera isolé.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>transition-snapshot</artifactId>
    <packaging>jar</packaging>
    <name>transition-snapshot</name>
    <description>Snapshot global de transition (BudgetDataModel, SettingsModel) et ports transverses MyFamilyBudget</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>treasury-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>retirement-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>tax-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>wealth-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>bank-pointage-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>credit-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>goals-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
