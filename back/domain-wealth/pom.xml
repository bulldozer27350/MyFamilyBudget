<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-040 (doc/architecture/20-backlog-modules-maven-patchs.md) : domaine Patrimoine
        (moteurs de projection patrimoniale et d'évolution des placements, règles de pause des
        versements, contrats d'entrée/sortie, modèles patrimoniaux, ports Reader/Writer).

        SILO-131 (décision D1) : aucune dépendance vers un autre silo (domain-budget a été dissous par SILO-140) ; le silo
        définit ses propres types (PatrimoineTransferModel, ScenarioAmountsModel). Aucune dépendance vers
        Spring, JPA, OpenAPI, PersistenceManager ou BudgetDataModel, et aucun retour vers Trésorerie.
        Dépendances de test uniquement : JUnit 5 et AssertJ (versions gérées par le BOM du parent).
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>domain-wealth</artifactId>
    <packaging>jar</packaging>
    <name>domain-wealth</name>
    <description>Domaine Patrimoine MyFamilyBudget (moteurs purs, sans Spring ni JPA)</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
