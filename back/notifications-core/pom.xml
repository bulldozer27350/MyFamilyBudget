<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SILO-158 (doc/architecture/21-plan-silotage.md) : cœur du silo Notifications (règles pures
        `DebitThresholdRule`, `BalanceFloorRule` et `ObjectifReachableRule`, implémentations de
        `NotificationRule` de `notifications-api`). SILO-180 y ajoute le dispatch (`DefaultNotificationDispatchService`),
        les paramètres (`DefaultNotificationSettingsService`, `NotificationSettingsCodec`) et le canal Web Push
        (`WebPushNotificationChannel`).

        SILO-217 : il porte aussi la persistance JPA autonome du silo (package `domain.notifications.core.persistence` :
        entités des paramètres, du journal d'envoi et des abonnements Web Push, repositories Spring Data et
        `Jpa*Store`, adaptateurs des ports `NotificationSettingsStore`, `NotificationSentLogStore` et
        `PushSubscriptionStore`), découverte par le scan par défaut de Spring Boot (racine
        `com.moe.myfamilybudget`).

        Règle : ce module ne dépend que de `notifications-api` et de `infra-jpa` ; les
        bibliothèques tierces `web-push`, `bcprov` et `httpclient` (canal Web Push), `jackson-databind` et slf4j
        n'y sont pas du Spring ni du JPA. Pas de `module-info` (décision D3) : visibilité
        tenue par le graphe Maven (règle C de `MavenModuleGraphTest`) et ArchUnit. Seul le composition root
        (server) le référence ; `application` ne dépend que de `notifications-api`. Les règles ne sont pas des
        @Component : leurs beans sont déclarés par `DomainEngineConfig`.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>notifications-core</artifactId>
    <packaging>jar</packaging>
    <name>notifications-core</name>
    <description>Cœur du silo Notifications MyFamilyBudget (règles pures, dispatch, paramètres, canal Web Push, et persistance JPA des paramètres, du journal d'envoi et des abonnements)</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>notifications-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>infra-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!--
            Web Push (notifications push mobile via PWA, RFC 8291/8292) — voir WebPushNotificationChannel.
            bcprov-jdk18on est requis par web-push pour le chiffrement AES128GCM/ECDH ; httpclient est déjà une
            dépendance transitive de web-push mais est explicitée ici pour fiabiliser la résolution.
        -->
        <dependency>
            <groupId>nl.martijndwars</groupId>
            <artifactId>web-push</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
