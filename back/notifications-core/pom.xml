<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SILO-158 (doc/architecture/21-plan-silotage.md) : cœur du silo Notifications (règles pures
        `DebitThresholdRule`, `BalanceFloorRule` et `ObjectifReachableRule`, implémentations de
        `NotificationRule` de `notifications-api`).

        Règle : ce module ne dépend que de `notifications-api`. Pas de `module-info` (décision D3) : visibilité
        tenue par le graphe Maven (règle C de `MavenModuleGraphTest`) et ArchUnit. Seul le composition root
        (server) le référence ; `application` ne dépend que de `notifications-api`. Les règles ne sont pas des
        @Component : leurs beans sont déclarés par `DomainEngineConfig`.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>notifications-core</artifactId>
    <packaging>jar</packaging>
    <name>notifications-core</name>
    <description>Cœur du silo Notifications MyFamilyBudget (règles de notification pures, sans Spring ni JPA)</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>notifications-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
