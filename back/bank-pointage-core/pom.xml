<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SILO-154 (doc/architecture/21-plan-silotage.md) : cœur du silo Banque/Pointage (moteurs de calcul
        `DefaultBankImportCalculationService` et `DefaultPointageCalculationService`, implémentations des
        interfaces de `bank-pointage-api`).

        Règle : ce module ne dépend que de `bank-pointage-api` (et, plus tard, de `infra-jpa`, SILO-213). Pas de
        `module-info` (décision D3) : visibilité tenue par le graphe Maven (règle C de `MavenModuleGraphTest`)
        et ArchUnit. Seul le composition root (server) le référence ; `application` ne dépend que de
        `bank-pointage-api`. Les moteurs ne sont pas des @Component : leurs beans sont déclarés par
        `DomainEngineConfig`. Dépendances de production en plus de l'API : slf4j-api (journalisation) et
        jackson-databind (lecture des réponses Enable Banking, SILO-170), versions gérées par le BOM du parent.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bank-pointage-core</artifactId>
    <packaging>jar</packaging>
    <name>bank-pointage-core</name>
    <description>Cœur du silo Banque/Pointage MyFamilyBudget (moteurs de calcul purs et intégration Enable Banking, sans Spring ni JPA)</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>bank-pointage-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
