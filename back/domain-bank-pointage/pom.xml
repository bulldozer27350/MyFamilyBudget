<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-060 (doc/architecture/20-backlog-modules-maven-patchs.md) : domaine Banque / Pointage
        (modèle d'import bancaire, calculateurs d'import et de pointage, contrats d'entrée,
        ligne budgétaire neutre, ports Reader/Writer).

        Aucune dépendance vers un autre module du reactor, ni vers Spring, JPA, OpenAPI,
        PersistenceManager ou BudgetDataModel. Seule dépendance de production : slf4j-api (journalisation
        des calculateurs, version gérée par le BOM du parent).
        Dépendances de test uniquement : JUnit 5 et AssertJ.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>domain-bank-pointage</artifactId>
    <packaging>jar</packaging>
    <name>domain-bank-pointage</name>
    <description>Domaine Banque/Pointage MyFamilyBudget (calculateurs purs, sans Spring ni JPA)</description>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
