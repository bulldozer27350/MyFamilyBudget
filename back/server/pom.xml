<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent reactor (MAVEN-000) : groupId et version (1.0.0-SNAPSHOT) hérités de back/pom.xml -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>server</artifactId>
    <name>server</name>
    <description>Serveur Spring Boot Java 21 pour l'application MyFamilyBudget</description>

    <properties>
        <!-- Seul module exécutable : réactive spring-boot:run (ignoré par défaut dans le parent) -->
        <spring-boot.run.skip>false</spring-boot.run.skip>
    </properties>

    <dependencies>
        <!-- Modèles du budget de base (MAVEN-010) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>domain-budget</artifactId>
        </dependency>

        <!-- Domaine Retraite : moteur, projections, modèle et ports (MAVEN-020) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>domain-retirement</artifactId>
        </dependency>

        <!-- Domaine Fiscalité : calculateur, projection, modèles et ports (MAVEN-030) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>domain-tax</artifactId>
        </dependency>

        <!-- Domaine Patrimoine : moteurs de projection, modèles et ports (MAVEN-040) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>domain-wealth</artifactId>
        </dependency>

        <!-- Domaine Banque/Pointage : import bancaire, pointage, ports (MAVEN-060) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>domain-bank-pointage</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- H2 Database (profil par défaut : distribution portable/standalone) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PostgreSQL Database (profil "docker" : conteneur + base PostgreSQL) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson & Swagger annotations for OpenAPI generation -->
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <!-- DevTools & Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            ArchUnit — garde-fou d'architecture (RF-001, doc/architecture/00-principes.md et
            01-sequencement.md) : vérifie par la compilation/CI, pas seulement par la discipline,
            que le package `calculation` ne dépend pas de `BudgetDataModel`.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Apache POI — Lecture fichiers Excel (.xls et .xlsx) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!--
            Web Push (notifications push mobile via PWA, RFC 8291/8292) — voir
            WebPushNotificationChannel. bcprov-jdk18on est une dépendance requise par web-push
            pour le chiffrement AES128GCM/ECDH ; httpclient est déjà une dépendance transitive de
            web-push mais est explicitée ici pour fiabiliser la résolution.
        -->
        <dependency>
            <groupId>nl.martijndwars</groupId>
            <artifactId>web-push</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Standard JAR Plugin with Main-Class in Manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.moe.myfamilybudget.ServerApplication</mainClass>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Spring Boot Plugin (Génération du Fat-JAR exécutable autonome) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.moe.myfamilybudget.ServerApplication</mainClass>
                            <layout>JAR</layout>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.moe.myfamilybudget.ServerApplication</mainClass>
                    <executable>true</executable>
                </configuration>
            </plugin>

            <!-- Synchronisation & Embarquement des assets du Front dans le Back -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>embed-frontend-assets</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/classes/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../view</directory>
                                    <includes>
                                        <include>*.html</include>
                                        <include>config.js</include>
                                        <include>css/**</include>
                                        <include>js/**</include>
                                        <include>assets/**</include>
                                    </includes>
                                    <excludes>
                                        <exclude>server.js</exclude>
                                        <exclude>package.json</exclude>
                                        <exclude>metadata.json</exclude>
                                        <exclude>scratch/**</exclude>
                                        <exclude>Manuel utilisateur.md</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                </configuration>
            </plugin>

            <!-- Clean target classes before compilation to prevent IDE file watchers from polluting bytecode -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-classes-before-compile</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                    <execution>
                        <id>clean-test-classes-before-test-compile</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/test-classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                openapi.yaml eclate ses chemins vers openapi/domains/*.yaml (RF-C00), qui a leur
                tour referencent en retour des schemas partages d'openapi.yaml via des chemins
                relatifs ('../../openapi.yaml#/components/schemas/...'). La resolution multi-fichiers
                interne a openapi-generator-maven-plugin (io.swagger:swagger-parser) ne deduplique
                pas un schema atteint par deux chemins de reference differents (local depuis la
                racine, relatif depuis un fichier externe) : elle lui attribue un suffixe numerique
                (comportement documente de OpenAPIResolver/ExternalRefProcessor pour les collisions de
                nom), generant deux classes Java distinctes pour un seul et meme schema (ex.
                BudgetDataDto et BudgetDataDto1), cause d'echecs de compilation dans les mappers qui
                utilisent l'une ou l'autre. Ce plugin installe un Node local au module (isole de tout
                Node/npm/Bun deja present sur la machine, pas besoin de dependance globale sur le
                poste de dev ni en CI) puis fusionne (bundle) la specification multi-fichiers en un
                unique document sans reference externe (back/server/package.json, script
                "openapi:bundle", io.swagger.parser n'est plus mis en cause), sur lequel
                openapi-generator-maven-plugin est ensuite execute : un schema n'existe alors plus
                qu'une fois, quel que soit le chemin d'origine qui y menait avant fusion.
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <installDirectory>${project.basedir}/target</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-for-openapi-bundle</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install-openapi-bundle-tool</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bundle-openapi-spec</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run openapi:bundle</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- OpenAPI Generator Maven Plugin -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/target/generated-openapi/openapi.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <apiPackage>com.moe.myfamilybudget.api.controller</apiPackage>
                            <modelPackage>com.moe.myfamilybudget.api.model</modelPackage>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot3>true</useSpringBoot3>
                                <recordDataModels>true</recordDataModels>
                                <useTags>true</useTags>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <openApiNullable>false</openApiNullable>
                                <useEnumCaseInsensitive>true</useEnumCaseInsensitive>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Build Helper Plugin to ensure generated sources are seen by IDEs -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/openapi/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Assembly Plugin (Génération du livrable ZIP portable autonome) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/portable-distribution.xml</descriptor>
                    </descriptors>
                    <finalName>MyFamilyBudget-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-portable-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!-- Eclipse m2e lifecycle mapping -->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.openapitools</groupId>
                                        <artifactId>openapi-generator-maven-plugin</artifactId>
                                        <versionRange>[0.0.0,)</versionRange>
                                        <goals>
                                            <goal>generate</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <execute>
                                            <runOnIncremental>true</runOnIncremental>
                                        </execute>
                                    </action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
