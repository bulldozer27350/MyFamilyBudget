<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent reactor (MAVEN-000) : groupId et version (1.0.0-SNAPSHOT) hérités de back/pom.xml -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>server</artifactId>
    <name>server</name>
    <description>Serveur Spring Boot Java 21 pour l'application MyFamilyBudget</description>

    <properties>
        <!-- Seul module exécutable : réactive spring-boot:run (ignoré par défaut dans le parent) -->
        <spring-boot.run.skip>false</spring-boot.run.skip>
    </properties>

    <dependencies>
        <!-- Modèles du budget de base (MAVEN-010) -->

        <!-- Silo Retraite : API (contrats, ports, interface de service) et cœur (moteur) ; SILO-150 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>retirement-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>retirement-core</artifactId>
        </dependency>

        <!-- Silo Fiscalité : API (contrats, ports, interface de service) et cœur (moteur) ; SILO-151 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>tax-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>tax-core</artifactId>
        </dependency>

        <!-- Silo Patrimoine : API (contrats, ports, interfaces de service) et cœur (moteurs) ; SILO-152 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>wealth-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>wealth-core</artifactId>
        </dependency>

        <!-- Silo Banque/Pointage : API (contrats, ports, interfaces de service) et cœur (moteurs) ; SILO-154 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>bank-pointage-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>bank-pointage-core</artifactId>
        </dependency>

        <!-- Silo Trésorerie : API (contrats, ports, interfaces de service) et cœur (moteur) ; SILO-153 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>treasury-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>treasury-core</artifactId>
        </dependency>

        <!-- Silo Analyse : API (contrat d'entrée, modèles de résultat, interface de service) et cœur (moteur) ; SILO-155 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>analysis-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>analysis-core</artifactId>
        </dependency>

        <!-- Silo Crédit : API (contrats, modèles, ports, interface de service) et cœur (moteur) ; SILO-156 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>credit-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>credit-core</artifactId>
        </dependency>

        <!-- Silo Objectifs : API (paramètres, contrats, modèles, ports) et cœur (persistance JPA) ; SILO-157, SILO-212 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>goals-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>goals-core</artifactId>
        </dependency>

        <!-- Silo Notifications : API (contrats, paramètres, entrées de règles) et cœur (règles) ; SILO-158 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>notifications-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>notifications-core</artifactId>
        </dependency>

        <!-- Silo Marché : API (cotations, ports, interface de service) et cœur (clients, agrégation) ; SILO-159 -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>market-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>market-core</artifactId>
        </dependency>

        <!-- Snapshot global de transition : BudgetDataModel, SettingsModel et ports transverses (MAVEN-100) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>transition-snapshot</artifactId>
        </dependency>

        <!-- Couche applicative : commands, factories d'Input, settings Objectifs (MAVEN-100) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>application</artifactId>
        </dependency>

        <!-- Infrastructure de persistance : entités JPA, repositories, adapters, PersistenceManager, cache et mutations (MAVEN-120) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>persistence</artifactId>
        </dependency>

        <!-- Configuration JPA/Hibernate commune aux silos : stratégie de nommage, aucun type métier (SILO-200) -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>infra-jpa</artifactId>
        </dependency>

        <!-- Contrat REST : DTO et interfaces Spring générés depuis openapi.yaml (MAVEN-110) ;
             apporte aussi jackson-databind-nullable et swagger-annotations -->
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>api</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- H2 Database (profil par défaut : distribution portable/standalone) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PostgreSQL Database (profil "docker" : conteneur + base PostgreSQL) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- DevTools & Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            ArchUnit — garde-fou d'architecture (RF-001, doc/architecture/00-principes.md et
            01-sequencement.md) : vérifie par la compilation/CI, pas seulement par la discipline,
            que le package `calculation` ne dépend pas de `BudgetDataModel`.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Standard JAR Plugin with Main-Class in Manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.moe.myfamilybudget.ServerApplication</mainClass>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Spring Boot Plugin (Génération du Fat-JAR exécutable autonome) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.moe.myfamilybudget.ServerApplication</mainClass>
                            <layout>JAR</layout>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.moe.myfamilybudget.ServerApplication</mainClass>
                    <executable>true</executable>
                </configuration>
            </plugin>

            <!-- Synchronisation & Embarquement des assets du Front dans le Back -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>embed-frontend-assets</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/classes/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../view</directory>
                                    <includes>
                                        <include>*.html</include>
                                        <include>config.js</include>
                                        <include>css/**</include>
                                        <include>js/**</include>
                                        <include>assets/**</include>
                                    </includes>
                                    <excludes>
                                        <exclude>server.js</exclude>
                                        <exclude>package.json</exclude>
                                        <exclude>metadata.json</exclude>
                                        <exclude>scratch/**</exclude>
                                        <exclude>Manuel utilisateur.md</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                </configuration>
            </plugin>

            <!-- Clean target classes before compilation to prevent IDE file watchers from polluting bytecode -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-classes-before-compile</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                    <execution>
                        <id>clean-test-classes-before-test-compile</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/test-classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Assembly Plugin (Génération du livrable ZIP portable autonome) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/portable-distribution.xml</descriptor>
                    </descriptors>
                    <finalName>MyFamilyBudget-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-portable-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
