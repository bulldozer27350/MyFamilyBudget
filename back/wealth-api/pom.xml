<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-040 puis SILO-152 (doc/architecture/21-plan-silotage.md) : API du silo Patrimoine
        (interfaces de service PatrimoineProjectionService et PlacementEvolutionService, contrats
        d'entrée/sortie, modèles patrimoniaux, ports Reader/Writer). Les moteurs et les règles de pause
        des versements vivent dans `wealth-core`. Nom de module Java inchangé
        (`com.moe.myfamilybudget.domain.wealth`).

        SILO-131 (décision D1) : aucune dépendance vers un autre silo (domain-budget a été dissous par SILO-140) ; le silo
        définit ses propres types (PatrimoineTransferModel, ScenarioAmountsModel). Aucune dépendance vers
        Spring, JPA, OpenAPI, PersistenceManager ou BudgetDataModel, et aucun retour vers Trésorerie.
        Aucune dépendance de test : le module ne contient que des contrats, testés par `wealth-core`.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>myfamilybudget-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>wealth-api</artifactId>
    <packaging>jar</packaging>
    <name>wealth-api</name>
    <description>API du silo Patrimoine MyFamilyBudget (contrats, ports, interfaces de service ; sans Spring ni JPA)</description>

</project>
