# Environment variables

# --- PostgreSQL (utilise par docker-compose et par le profil Spring "docker") ---
POSTGRES_DB=myfamilybudget
POSTGRES_USER=myfamilybudget
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Application ---
APP_PORT=8080

# --- Banque de France (Webstat) ---
# Cle d'API gratuite pour le taux de marche des credits immobiliers (analyse des prets).
# Optionnelle : vide => la source est ignoree et le taux de marche se saisit a la main.
# Sans espaces ni guillemets autour de la valeur.
MYFAMILYBUDGET_BDF_API_KEY=

# --- Enable Banking (synchronisation bancaire DSP2) ---
# Optionnelle : vide (ou certificat absent) => synchronisation desactivee, log au demarrage,
# le reste de l'application fonctionne normalement.
# Application-id de ton application Enable Banking (sandbox ou production).
MYFAMILYBUDGET_ENABLE_BANKING_APPLICATION_ID=
# Liste des comptes a synchroniser, format "libelle 1|uid-1;libelle 2|uid-2;...".
# Les uid sont ceux recuperes aupres d'Enable Banking (etape POST /sessions).
MYFAMILYBUDGET_ENABLE_BANKING_ACCOUNTS=
# Chemin, sur CETTE machine (l'hote), du dossier contenant private_key.pem. Ce chemin est
# monte en lecture seule dans le conteneur (voir docker-compose.prod.yml) ; le certificat
# lui-meme ne doit JAMAIS etre commite ni copie dans l'image. Par defaut, le dossier
# ./secrets/enable-banking du depot (deja pret, ignore par Git sauf lui-meme).
MYFAMILYBUDGET_ENABLE_BANKING_SECRETS_DIR=./secrets/enable-banking

# --- Watchtower (mise a jour automatique de l'image Docker) ---
# Intervalle en secondes entre deux verifications de nouvelle image sur Docker Hub.
WATCHTOWER_POLL_INTERVAL=300
TZ=Europe/Paris