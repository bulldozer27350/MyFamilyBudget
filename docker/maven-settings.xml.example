<?xml version="1.0" encoding="UTF-8"?>
<!--
    Modele de settings.xml pour la compilation du Dockerfile racine.

    Le Dockerfile ne copie plus les sources des *-api/*-core des silos extraits (credit, retirement,
    tax, wealth, bank-pointage, treasury, analysis, goals, settings, notifications, market) : ils
    sont resolus comme de simples dependances Maven depuis les depots GitHub Packages
    "domain-<nom>-packages" declares dans back/pom.xml. Chacun exige une authentification meme en
    lecture seule.

    Usage local (build manuel de l'image avant publication) :
      1) Copier ce fichier en dehors du depot, par ex. :
           copy docker\maven-settings.xml.example %TEMP%\maven-settings.xml
      2) Remplacer YOUR_GITHUB_USERNAME et YOUR_GITHUB_PAT ci-dessous (PAT avec le scope
         read:packages, le meme que les DOMAIN_<NOM>_PACKAGES_READ_TOKEN cote CI ; un seul PAT peut
         servir pour tous les serveurs ci-dessous).
      3) Construire l'image en fournissant ce fichier comme secret BuildKit (jamais copie dans une
         couche de l'image, uniquement monte pendant le RUN qui en a besoin) :
           docker build --secret id=maven_settings,src=%TEMP%\maven-settings.xml -t myfamilybudget .

    Ne jamais committer de copie de ce fichier contenant un vrai token.
-->
<settings>
    <servers>
        <server>
            <id>domain-credit-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-retirement-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-tax-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-wealth-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-bank-pointage-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-treasury-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-analysis-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-goals-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-settings-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-notifications-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
        <server>
            <id>domain-market-packages</id>
            <username>YOUR_GITHUB_USERNAME</username>
            <password>YOUR_GITHUB_PAT</password>
        </server>
    </servers>
</settings>
