<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Silo Parametres (Simulation, Hypotheses economiques) (settings-core) : changelog Liquibase du silo (R-01, 24-backlog-reste-a-faire.md).
        Tables actuelles : app_settings.

        Lot B (R-01) : changeSet de baseline ci-dessous, genere via `mvn liquibase:generateChangeLog`
        (cf. db/changelog/README.md, module server) sur une base neuve (reset propre, pas de
        reverse-engineering de l'existant : voir 23-registre-decisions-actives.md, DA-16). Tables
        legacy orphelines (anciens noms pre-renommage de silo, cf. LegacySchemaCleanup) exclues.
    -->

    <changeSet author="R-01-lot-b" id="r01-settings-core-1">
        <createTable tableName="app_settings">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="app_settings_pkey"/>
            </column>
            <column name="inflation_rate" type="numeric(19, 8)"/>
            <column name="simulate_until_age" type="INTEGER"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
